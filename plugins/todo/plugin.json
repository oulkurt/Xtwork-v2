{
  "id": "todo",
  "name": "待办",
  "version": "1.0.0",
  "api": 2,
  "kind": "functional",
  "description": "管理待办事项。",
  "icon": "plugin-addon-puzzle",
  "worker": "worker.js",
  "capabilities": [
    "storage",
    "agent.tools"
  ],
  "contributes": {
    "tools": [
      {
        "name": "create",
        "title": "新建待办",
        "description": "Create a todo with a title and optional notes, group, local due date, time, and priority.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Item title."
            },
            "notes": {
              "type": "string",
              "maxLength": 2000
            },
            "group": {
              "type": "string",
              "maxLength": 40
            },
            "due": {
              "type": "string",
              "description": "User local timezone date YYYY-MM-DD, or empty to clear."
            },
            "time": {
              "type": "string",
              "description": "User local timezone time HH:MM; requires due, or empty to clear."
            },
            "priority": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "title"
          ]
        },
        "confirm": false
      },
      {
        "name": "list",
        "title": "列出待办",
        "description": "List todos by filter, optional group or title query, or read one todo by ID. Today and week use the user local timezone; week includes today and the following six days.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filter": {
              "type": "string",
              "enum": [
                "all",
                "today",
                "week",
                "done",
                "overdue"
              ]
            },
            "group": {
              "type": "string",
              "maxLength": 40
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "Start at this index. Use nextOffset from the previous page."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum items to return; default 50."
            },
            "query": {
              "type": "string",
              "maxLength": 200,
              "description": "Search todo titles."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Read one referenced todo by its exact ID, including completed todos."
            },
            "fullNotes": {
              "type": "boolean",
              "default": false,
              "description": "Return full note text instead of compact previews."
            }
          },
          "additionalProperties": false
        },
        "confirm": false
      },
      {
        "name": "update",
        "title": "修改待办",
        "description": "Update an existing todo. Only supplied fields are changed.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "notes": { "type": "string", "maxLength": 2000 },
            "group": { "type": "string", "maxLength": 40 },
            "due": { "type": "string", "description": "User local timezone date YYYY-MM-DD, or empty to clear." },
            "time": { "type": "string", "description": "User local timezone time HH:MM; requires due, or empty to clear." },
            "priority": { "type": "string", "enum": ["none", "low", "medium", "high"] }
          },
          "additionalProperties": false,
          "required": ["id"]
        },
        "confirm": false
      },
      {
        "name": "complete",
        "title": "完成待办",
        "description": "Mark a todo as completed or reopen it.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "done": { "type": "boolean", "default": true }
          },
          "additionalProperties": false,
          "required": ["id"]
        },
        "confirm": false
      },
      {
        "name": "delete",
        "title": "删除待办",
        "description": "Delete an existing todo.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "undoCreatedAt": { "type": "string", "maxLength": 40 }
          },
          "additionalProperties": false,
          "required": ["id"]
        },
        "confirm": false
      }
    ],
    "views": [
      {
        "id": "todo",
        "title": "待办",
        "placement": "panel",
        "entry": "ui/todo.html"
      }
    ]
  }
}
