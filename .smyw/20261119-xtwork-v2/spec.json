  "flows": [
    {
      "id": "record-action",
      "name": "聊天记待办",
      "change": "added",
      "steps": [
        {
          "id": "todo-say",
          "actor": "user",
          "text": "周五前把季度报告发给负责人",
          "node": "sample-todo"
        },
        {
          "id": "todo-write",
          "actor": "backend",
          "text": "助手调用工具，插件宿主写入待办",
          "fn": "todo__create"
        },
        {
          "id": "todo-ack",
          "actor": "frontend",
          "text": "显示已保存、打开和撤销",
          "node": "todo-receipt"
        }
      ]
    },
    {
      "id": "schedule-event",
      "name": "聊天记日程",
      "change": "added",
      "steps": [
        {
          "id": "calendar-say",
          "actor": "user",
          "text": "明天下午三点到四点开评审会",
          "node": "sample-calendar"
        },
        {
          "id": "calendar-write",
          "actor": "backend",
          "text": "读取当前时区，写入正确日期的日程",
          "fn": "app__current_time → calendar__create"
        },
        {
          "id": "calendar-ack",
          "actor": "frontend",
          "text": "显示已保存的起止时间",
          "node": "calendar-receipt"
        }
      ]
    },
    {
      "id": "cite-note",
      "name": "引用 Obsidian 笔记",
      "change": "added",
      "steps": [
        {
          "id": "note-pick",
          "actor": "user",
          "text": "选中一篇已授权的笔记",
          "node": "choose-review-note"
        },
        {
          "id": "note-send",
          "actor": "frontend",
          "text": "发送消息和用户选中的笔记内容",
          "node": "send-note",
          "fn": "obsidian-note → composer context"
        },
        {
          "id": "note-answer",
          "actor": "frontend",
          "text": "展示总结和笔记来源",
          "node": "note-reply"
        }
      ]
    },
    {
      "id": "remote-connect",
      "name": "连接飞书试点",
      "change": "added",
      "steps": [
        {
          "id": "feishu-open",
          "actor": "user",
          "text": "在设置开启飞书连接",
          "node": "connect-feishu"
        },
        {
          "id": "feishu-pair",
          "actor": "external",
          "text": "在已配置机器人私聊里绑定用户",
          "node": "feishu-dialog"
        },
        {
          "id": "feishu-dispatch",
          "actor": "backend",
          "text": "接收任务，转入产品对话，返回最终结果",
          "fn": "agent.thread.send"
        }
      ]
    }
