+        instanceId: "codex",
+        source: "codex-managed",
+        version: pending!.version,
+        distribution: "codex-release",
+        installDir: first.installation.managedDirectory,
+        artifactSpec: pending!.url,
+        artifactDigest: pending!.sha256,
+      }),
+    );
+
+    // M2: Omitting approvalToken MUST fail closed even while an approval token is pending!
+    const missingToken = yield* Effect.flip(
+      first.installation.startForInstance!({
+        instanceId: "codex",
+        expectedVersion: "0.156.1",
+        expectedSha256: sha256,
+      }),
+    );
+    expect(missingToken.operation).toBe("install_required");
+    expect(singleUse.has("codex-tok-1")).toBe(true);
+    expect(first.downloads()).toBe(0);
+
+    const badDigest = yield* Effect.flip(
+      first.installation.startForInstance!({
+        instanceId: "codex",
+        approvalToken: "codex-tok-1",
+        expectedVersion: "0.156.1",
+        expectedSha256: "0".repeat(64),
+      }),
+    );
+    expect(badDigest.operation).toBe("install_required");
+    expect(singleUse.has("codex-tok-1")).toBe(true);
+
+    yield* first.installation.startForInstance!({
+      instanceId: "codex",
+      approvalToken: "codex-tok-1",
+      expectedVersion: "0.156.1",
+      expectedSha256: sha256,
+    });
+    expect((yield* terminalState(first.installation)).phase).toBe("succeeded");
+    expect(singleUse.has("codex-tok-1")).toBe(false);
+    expect(first.downloads()).toBe(1);
+
+    const raised = yield* makeHarness({
+      baseDir,
+      options: {
+        releaseAsset: {
+          ...asset,
+          version: "0.160.0",
+          sha256,
+        },
+      },
+    }).pipe(Effect.provide(consentGateLayer));
+    const startupState = yield* raised.installation.state;
+    expect(startupState.installedVersion).toBe("0.156.1");
+    expect(startupState.version).toBe("0.160.0");
+    expect(startupState.phase).toBe("idle");
+    expect(raised.downloads()).toBe(0);
+
+    const unapprovedUpdate = yield* Effect.flip(
+      raised.installation.startForInstance!({ instanceId: "codex" }),
+    );
+    expect(unapprovedUpdate.operation).toBe("update_required");
+    expect(raised.downloads()).toBe(0);
+  }).pipe(Effect.scoped, Effect.provide(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer))),
