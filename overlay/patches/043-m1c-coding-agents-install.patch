+    .filter(
+      (entry) =>
+        entry.length > 0 &&
+        normalizePathSegmentForPlatform(entry, platform) !== normalizedBundled,
+    );
+  const merged = mergePathEntries(existingEntries.join(delimiter), bundledNodeBin, platform);
+  if (merged) {
+    env.PATH = merged;
+  }
