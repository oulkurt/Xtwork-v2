+        key.distribution,
+        key.installDir,
+        key.artifactSpec,
+        key.artifactDigest,
+      ]);
+    const consentGateLayer = Layer.succeed(CodexInstallation.CodexInstallConsentGate, {
+      consumeInstallApproval: (key, token) =>
+        Effect.sync(() => {
+          if (typeof token !== "string" || token.trim().length === 0) return false;
+          const expected = keyOf(key);
