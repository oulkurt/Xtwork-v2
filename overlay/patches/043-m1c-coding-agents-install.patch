+function normalizePathSegmentForPlatform(segment: string, platform: NodeJS.Platform): string {
+  const trimmed = segment.trim();
+  if (!trimmed) return "";
+  if (platform === "win32") {
+    return NodePath.win32.normalize(trimmed).replace(/[\\\/]+$/u, "").toLowerCase();
+  }
+  const normalized = NodePath.posix.normalize(trimmed);
+  return normalized.length > 1 ? normalized.replace(/\/+$/u, "") : normalized;
+}
