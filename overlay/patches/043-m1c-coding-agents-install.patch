+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const baseDir = yield* fs.makeTempDirectoryScoped({ prefix: "t3-codex-consent-gate-" });
+    const digest = yield* Digest.Digest;
+    const sha256 = Hex.encode(yield* digest.digest(Digest.sha256, archive).pipe(Effect.orDie));
+    const singleUse = new Map<string, string>();
+    const keyOf = (key: CodexInstallation.CodexInstallConsentKey) =>
