+        entry.frame.method === "turn/start" &&
+        isRecord(entry.frame.params) &&
+        Array.isArray(entry.frame.params.input)
+      ) {
+        let changed = false;
+        const nextInput = entry.frame.params.input.map((part) => {
+          if (!isRecord(part) || part.type !== "text" || typeof part.text !== "string") return part;
+          const upgraded = upgradeLegacyRuntimeBrandText(part.text);
+          if (upgraded === part.text) return part;
+          changed = true;
+          return { ...part, text: upgraded };
+        });
+        if (!changed) return entry;
+        return {
+          ...entry,
+          frame: {
+            ...entry.frame,
+            params: {
+              ...entry.frame.params,
+              input: nextInput,
+            },
+          },
+        };
+      }
+      return entry;
+    }),
+  };
+}
