+  // Reload models.json into Pi's live ModelRuntime without restarting the RPC session.
+  // When idle and the active model still exists, re-apply the refreshed definition so
+  // metadata updates (baseUrl/compat/limits) take effect on the very next turn.
+  pi.registerCommand(RELOAD_MODELS_COMMAND, {
+    description: "Reload models.json into the active Pi session model registry",
+    handler: async (_args, ctx) => {
+      await ctx.modelRegistry.refresh({ allowNetwork: false });
+      if (!ctx.isIdle()) return;
+      const current = ctx.model;
+      if (!current) return;
+      const refreshed = ctx.modelRegistry.find(current.provider, current.id);
+      if (
+        refreshed &&
+        ctx.modelRegistry
+          .getAvailable()
+          .some((candidate) => candidate.provider === current.provider && candidate.id === current.id)
+      ) {
