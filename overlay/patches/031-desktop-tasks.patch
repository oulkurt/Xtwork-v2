+function DesktopDraftLanding() {
+  const { openScratchProject, primaryScratchEnvironmentId } = useScratchProject();
+  const environmentId = primaryScratchEnvironmentId();
+  const bootstrapped = useAllEnvironmentShellsBootstrapped();
+  const handleNewThread = useNewThreadHandler();
+  const router = useRouter();
+  const [retry, setRetry] = useState(0);
+  const [failedAttempt, setFailedAttempt] = useState<number | null>(null);
+  const openDraft = useEffectEvent(async (target: NonNullable<typeof environmentId>) => {
+    const project = await openScratchProject(target);
+    if (router.state.location.pathname !== "/") return true;
+    if (project === null) return false;
+    return (
+      (await handleNewThread(scopeProjectRef(project.environmentId, project.id), {
+        envMode: "local",
+        replace: true,
+      })) !== null || router.state.location.pathname !== "/"
+    );
+  });
+
+  useEffect(() => {
+    if (environmentId === null) return;
+    let active = true;
+    void openDraft(environmentId).then(
+      (opened) => {
+        if (active && !opened) setFailedAttempt(retry);
+      },
+      () => {
+        if (active) setFailedAttempt(retry);
+      },
+    );
+    return () => {
+      active = false;
+    };
+  }, [environmentId, retry]);
+
+  if (failedAttempt === retry) {
+    return <DraftStartError onRetry={() => setRetry((attempt) => attempt + 1)} />;
+  }
+  return environmentId === null && bootstrapped ? <NoProjectsHero /> : null;
 }
 
