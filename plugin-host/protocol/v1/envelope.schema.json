{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xtwork:protocol:v1:envelope",
  "title": "xtwork JSONL v1 envelope",
  "description": "peer 连接的 envelope 契约。接收方先做本校验，再按 messages.schema.json 的 message 定义校验。规则见 README.md。",
  "type": "object",
  "required": ["protocol", "version", "kind", "id", "seq", "sessionId", "payload", "error", "meta"],
  "properties": {
    "protocol": {"const": "xtwork"},
    "version": {"$ref": "#/$defs/version"},
    "kind": {"enum": ["request", "response", "event", "cancel"]},
    "id": {"$ref": "#/$defs/id"},
    "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sessionId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "method": {"$ref": "#/$defs/name"},
    "event": {"$ref": "#/$defs/name"},
    "payload": {"type": ["object", "null"]},
    "error": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]},
    "meta": {"$ref": "#/$defs/meta"}
  },
  "allOf": [
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "request"}}},
      "then": {
        "required": ["method"],
        "not": {"required": ["event"]},
        "properties": {"payload": {"type": "object"}, "error": {"type": "null"}}
      }
    },
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "response"}}},
      "then": {
        "required": ["method"],
        "not": {"required": ["event"]},
        "oneOf": [
          {"properties": {"payload": {"type": "object"}, "error": {"type": "null"}}},
          {"properties": {"payload": {"type": "null"}, "error": {"type": "object"}}}
        ]
      }
    },
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "event"}}},
      "then": {
        "required": ["event"],
        "not": {"required": ["method"]},
        "properties": {"payload": {"type": "object"}, "error": {"type": "null"}}
      }
    },
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "cancel"}}},
      "then": {
        "not": {"anyOf": [{"required": ["method"]}, {"required": ["event"]}]},
        "properties": {"payload": {"$ref": "#/$defs/cancelPayload"}, "error": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]{1,3}[.][0-9]{1,3}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "name": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)*$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "meta": {
      "type": "object",
      "required": ["sender", "sentAt"],
      "properties": {
        "sender": {"type": "string", "pattern": "^(host|pi|auth|plugin:[a-z0-9][a-z0-9._-]{0,127})$"},
        "sentAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$"},
        "requestId": {"$ref": "#/$defs/id"},
        "trace": {"type": "object"}
      }
    },
    "cancelPayload": {
      "type": "object",
      "required": ["targetRequestId", "reason"],
      "properties": {"targetRequestId": {"$ref": "#/$defs/id"}, "reason": {"$ref": "#/$defs/token"}}
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "recovery", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "recovery": {"$ref": "#/$defs/token"},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      }
    }
  }
}
