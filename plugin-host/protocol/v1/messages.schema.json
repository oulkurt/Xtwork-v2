{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xtwork:protocol:v1:messages",
  "title": "xtwork JSONL v1 message catalog",
  "description": "按 message 键约束整帧的 sessionId、payload 和 meta。键为 request.<method>、response.<method>（只用于成功 response）、event.<event>。不含点号的键是共享片段。规则见 README.md 第 6 节与第 11 节。",
  "$defs": {
    "request.hello": {
      "type": "object",
      "properties": {
        "sessionId": {"type": "null"},
        "payload": {
          "type": "object",
          "required": ["role", "supportedVersions", "methods", "runtime"],
          "properties": {
            "role": {"const": "host"},
            "supportedVersions": {"$ref": "#/$defs/versionList"},
            "methods": {"$ref": "#/$defs/methodList"},
            "runtime": {"$ref": "#/$defs/runtime"}
          }
        }
      }
    },
    "response.hello": {
      "type": "object",
      "properties": {
        "sessionId": {"type": "null"},
        "payload": {
          "type": "object",
          "required": ["role", "selectedVersion", "methods", "runtime"],
          "properties": {
            "role": {"enum": ["pi", "plugin", "auth"]},
            "selectedVersion": {"$ref": "#/$defs/version"},
            "methods": {"$ref": "#/$defs/methodList"},
            "runtime": {"$ref": "#/$defs/runtime"}
          }
        }
      }
    },
    "request.plugin.load": {"allOf": [{"$ref": "#/$defs/plugin13"}], "properties": {"payload": {"type": "object", "required": ["pluginId", "api", "entry", "files", "capabilities", "tools", "view", "schedule"], "properties": {"pluginId": {"$ref": "#/$defs/localId"}, "api": {"enum": [1, 2]}, "timeZone": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$", "not": {"pattern": "[^A-Za-z0-9_+/-]"}}, "entry": {"type": "string", "minLength": 1, "maxLength": 1024}, "files": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "required": ["path", "text"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "text": {"type": "string", "maxLength": 4194304}}}}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["storage", "notify", "schedule", "usage.read", "fs.folder", "agent.tools"]}}, "tools": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/toolName"}}, "view": {"type": "boolean"}, "schedule": {"type": "boolean"}}}}},
    "response.plugin.load": {"allOf": [{"$ref": "#/$defs/plugin13"}], "properties": {"payload": {"type": "object", "required": ["tools", "view", "schedule"], "properties": {"tools": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/toolName"}}, "view": {"type": "boolean"}, "schedule": {"type": "boolean"}}}}},
    "request.plugin.invoke": {"allOf": [{"$ref": "#/$defs/plugin13"}], "properties": {"payload": {"type": "object", "required": ["kind", "name", "input"], "properties": {"kind": {"enum": ["tool", "view", "schedule"]}, "name": {"type": "string", "minLength": 1, "maxLength": 256}, "input": {}, "context": {"type": "object"}}}}},
    "response.plugin.invoke": {"allOf": [{"$ref": "#/$defs/plugin13"}], "properties": {"payload": {"type": "object", "required": ["output"], "properties": {"output": {}}}}},
    "request.capability.call": {"allOf": [{"$ref": "#/$defs/plugin13"}], "properties": {"payload": {"type": "object", "required": ["capability", "method", "params"], "properties": {"capability": {"type": "string", "minLength": 1, "maxLength": 64}, "method": {"type": "string", "minLength": 1, "maxLength": 64}, "params": {}}}}},
    "response.capability.call": {"allOf": [{"$ref": "#/$defs/plugin13"}], "properties": {"payload": {"type": "object", "required": ["result"], "properties": {"result": {}}}}},
    "event.plugin.log": {"allOf": [{"$ref": "#/$defs/plugin13"}], "properties": {"payload": {"type": "object", "required": ["level", "text"], "properties": {"level": {"enum": ["debug", "info", "warn", "error"]}, "text": {"type": "string"}}}}},
    "plugin13": {"type": "object", "properties": {"sessionId": {"type": "null"}}, "allOf": [{"if": {"properties": {"version": {"enum": ["1.0", "1.1", "1.2"]}}, "required": ["version"]}, "then": false}]},
    "request.shutdown": {"$ref": "#/$defs/connectionScoped"},
    "response.shutdown": {"$ref": "#/$defs/connectionScoped"},
    "version": {"type": "string", "pattern": "^[0-9]{1,3}[.][0-9]{1,3}$"},
    "versionList": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/version"}},
    "methodName": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)*$"},
    "methodList": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/methodName"}},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 256},
    "localId": {"type": "string", "minLength": 1, "maxLength": 128},
    "toolName": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "connectionScoped": {"type": "object", "properties": {"sessionId": {"type": "null"}, "payload": {"type": "object"}}}
  }
}
