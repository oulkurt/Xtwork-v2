{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xtwork:protocol:v2:plugin-manifest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" },
        "api": { "const": 2 },
        "kind": { "const": "functional" },
        "description": { "type": "string", "maxLength": 200 },
        "icon": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "worker": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*\\.(ts|js)$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["storage", "agent.tools", "notify", "schedule", "usage.read", "fs.folder"] } },
        "contributes": {
          "type": "object",
          "properties": {
            "tools": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "maxLength": 32, "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
                  "title": { "type": "string", "minLength": 1 },
                  "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
                  "inputSchema": { "type": "object", "properties": { "type": { "const": "object" } }, "required": ["type"] },
                  "confirm": { "type": "boolean" }
                },
                "required": ["name", "title", "description", "inputSchema"],
                "additionalProperties": false
              }
            },
            "views": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
                  "title": { "type": "string", "minLength": 1 },
                  "placement": { "enum": ["panel", "sidebar", "settings"] },
                  "entry": { "type": "string", "pattern": "^ui/[^\\\\]+\\.html$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" } }
                },
                "required": ["id", "title", "placement", "entry"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "version", "api", "kind", "description", "icon", "worker", "capabilities", "contributes"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" },
        "api": { "const": 2 },
        "kind": { "const": "appearance" },
        "description": { "type": "string", "maxLength": 200 },
        "icon": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "contributes": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
                "tokens": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 64,
                  "propertyNames": { "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)*$" },
                  "additionalProperties": { "type": "string", "maxLength": 200 }
                }
              },
              "required": ["id", "tokens"],
              "additionalProperties": false
            }
          },
          "required": ["theme"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "version", "api", "kind", "description", "icon", "contributes"],
      "additionalProperties": false
    }
  ]
}
